{
  "name": "frukt116-storefront",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js -k \"vite\" \"npm:server:dev\"",
    "server:dev": "node --watch server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.js --production",
    "check": "tsc -b && node scripts/check-project.mjs",
    "test": "node --test tests/*.test.mjs",
    "orders": "node scripts/list-orders.mjs",
    "admin:link": "node scripts/admin-link.mjs"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "typescript": "~5.8.3",
    "vite": "^6.4.3"
  }
}
